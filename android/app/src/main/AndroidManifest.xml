<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- firebase-analytics подтягивает это разрешение транзитивно. Мы не
         показываем рекламу и не строим рекламные аудитории, а его наличие
         обязывает объявить сбор Advertising ID в Play Data safety и попадает
         под политику для детских приложений. Убираем на этапе слияния
         манифестов — сбор AD_ID дополнительно выключен ниже. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- То же самое в варианте Privacy Sandbox (Android 13+): новые версии
         play-services-measurement добавляют его вместо AD_ID. Оставленное
         разрешение заставило бы Play Console требовать декларации сбора
         рекламного идентификатора, которого у нас нет. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <application
        android:label="Wawat Air"
        android:name=".WawatApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/LaunchTheme"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Notification taps whose click_action is FLUTTER_NOTIFICATION_CLICK
                 must resolve to this activity, otherwise the tap opens nothing.
                 firebase_messaging then delivers the message via
                 onMessageOpenedApp / getInitialMessage. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Default high-importance channel for FCM (Android 8+). Must match the
             channel id created in WawatApplication.kt / push_notification_service.dart.
             Notification-type pushes with no explicit channel_id land here. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wawat_airplane_v5" />

        <!-- Small status-bar icon for FCM notifications: a white silhouette of
             the Wawat double-check mark. Without this, Firebase falls back to
             ic_launcher, which the OS renders as a tiny tinted blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_wawat" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- ── Аналитика: только продуктовая диагностика ────────────────────
             Никаких рекламных идентификаторов и сигналов для таргетинга.
             Именно это позволяет заявить в Play Data safety и App Privacy,
             что данные не используются для рекламы и не передаются третьим
             лицам, и не показывать пользователю ATT-запрос на iOS. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- Crashlytics и Performance стартуют включёнными; фактический сбор
             включает/выключает пользователь в «Məxfilik» — приложение
             применяет его выбор через setCrashlyticsCollectionEnabled()
             при каждом запуске (см. telemetry.dart). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="true" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
